// flecs::internal
//
// Raw FFI declarations for the Flecs C API (Flecs 4.1.6).
// Internal plumbing for the public `flecs` module; not a supported API surface.

module flecs::internal;

// ---------------------------------------------------------------------------
// Scalar aliases
// ---------------------------------------------------------------------------

alias EcsId = ulong;
alias EcsEntity = ulong;
alias EcsSize = int;
alias EcsFtime = float;
alias EcsFlags8 = char;
alias EcsFlags16 = ushort;
alias EcsFlags32 = uint;
alias EcsFlags64 = ulong;
alias EcsTermset = uint;
alias EcsPoly = void;

// Opaque handle types.
alias EcsWorld = void;
alias EcsStage = void;
alias EcsTable = void;
alias EcsQuery = void;
alias EcsObserver = void;
alias EcsObservable = void;
alias EcsRecord = void;
alias EcsComponentRecord = void;
alias EcsMixins = void;
alias EcsTableRecord = void;
alias EcsAllocator = void;
alias EcsStack = void;
alias EcsStackCursor = void;
alias EcsHashMap = void;
alias EcsSparse = void;
alias EcsMap = void;
alias EcsData = void;
alias EcsStrbuf = void;

// ---------------------------------------------------------------------------
// Function pointer types
// ---------------------------------------------------------------------------

alias EcsRunAction = fn void(EcsIter* it);
alias EcsIterAction = fn void(EcsIter* it);
alias EcsIterNextAction = fn bool(EcsIter* it);
alias EcsIterFiniAction = fn void(EcsIter* it);
alias EcsOrderByAction = fn int(EcsEntity e1, void* ptr1, EcsEntity e2, void* ptr2);
alias EcsSortTableAction = fn void(EcsWorld* world, EcsTable* table, EcsEntity* entities, void* ptr, int size, int lo, int hi, EcsOrderByAction order_by);
alias EcsGroupByAction = fn ulong(EcsWorld* world, EcsTable* table, EcsId group_id, void* ctx);
alias EcsGroupCreateAction = fn void*(EcsWorld* world, ulong group_id, void* group_by_ctx);
alias EcsGroupDeleteAction = fn void(EcsWorld* world, ulong group_id, void* group_ctx, void* group_by_ctx);
alias EcsModuleAction = fn void(EcsWorld* world);
alias EcsFiniAction = fn void(EcsWorld* world, void* ctx);
alias EcsCtxFree = fn void(void* ctx);
alias EcsCompareAction = fn int(void* ptr1, void* ptr2);
alias EcsHashValueAction = fn ulong(void* ptr);
alias EcsXtor = fn void(void* ptr, int count, EcsTypeInfo* type_info);
alias EcsCopy = fn void(void* dst_ptr, void* src_ptr, int count, EcsTypeInfo* type_info);
alias EcsMove = fn void(void* dst_ptr, void* src_ptr, int count, EcsTypeInfo* type_info);
alias EcsCmp = fn int(void* a_ptr, void* b_ptr, EcsTypeInfo* type_info);
alias EcsEquals = fn bool(void* a_ptr, void* b_ptr, EcsTypeInfo* type_info);
alias FlecsPolyDtor = fn void(EcsPoly* poly);

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

constdef EcsInOutKind : int
{
	IN_OUT_DEFAULT,
	IN_OUT_NONE,
	IN_OUT_FILTER,
	IN_OUT,
	IN,
	OUT,
}

constdef EcsOperKind : int
{
	AND,
	OR,
	NOT,
	OPTIONAL,
	AND_FROM,
	OR_FROM,
	NOT_FROM,
}

constdef EcsQueryCacheKind : int
{
	QUERY_CACHE_DEFAULT,
	QUERY_CACHE_AUTO,
	QUERY_CACHE_ALL,
	QUERY_CACHE_NONE,
}

constdef EcsTypeKind : int
{
	PRIMITIVE_TYPE,
	BITMASK_TYPE,
	ENUM_TYPE,
	STRUCT_TYPE,
	ARRAY_TYPE,
	VECTOR_TYPE,
	OPAQUE_TYPE,
	TYPE_KIND_LAST,
}

constdef EcsPrimitiveKind : int
{
	BOOL = 1,
	CHAR,
	BYTE,
	U8,
	U16,
	U32,
	U64,
	I8,
	I16,
	I32,
	I64,
	F32,
	F64,
	UPTR,
	IPTR,
	STRING,
	ENTITY,
	ID,
	PRIMITIVE_KIND_LAST,
}

// ---------------------------------------------------------------------------
// Structs
// ---------------------------------------------------------------------------

struct EcsType
{
	EcsId* array;
	int count;
}

struct EcsTypeHooks
{
	EcsXtor ctor;
	EcsXtor dtor;
	EcsCopy copy;
	EcsMove move;
	EcsCopy copy_ctor;
	EcsMove move_ctor;
	EcsMove ctor_move_dtor;
	EcsMove move_dtor;
	EcsCmp cmp;
	EcsEquals equals;
	EcsFlags32 flags;
	EcsIterAction on_add;
	EcsIterAction on_set;
	EcsIterAction on_remove;
	EcsIterAction on_replace;
	void* ctx;
	void* binding_ctx;
	void* lifecycle_ctx;
	EcsCtxFree ctx_free;
	EcsCtxFree binding_ctx_free;
	EcsCtxFree lifecycle_ctx_free;
}

struct EcsTypeInfo
{
	EcsSize size;
	EcsSize alignment;
	EcsTypeHooks hooks;
	EcsEntity component;
	ZString name;
}

struct EcsTermRef
{
	EcsEntity id;
	ZString name;
}

struct EcsTerm
{
	EcsId id;
	EcsTermRef src;
	EcsTermRef first;
	EcsTermRef second;
	EcsEntity trav;
	short inout;
	short oper;
	ichar field_index;
	EcsFlags16 flags_;
}

struct EcsValue
{
	EcsEntity type;
	void* ptr;
}

struct EcsEntityDesc
{
	int _canary;
	EcsEntity id;
	EcsEntity parent;
	ZString name;
	ZString sep;
	ZString root_sep;
	ZString symbol;
	bool use_low_id;
	EcsId* add;
	EcsValue* set;
	ZString add_expr;
}

struct EcsBulkDesc
{
	int _canary;
	EcsEntity* entities;
	int count;
	EcsId[32] ids;
	void** data;
	EcsTable* table;
}

struct EcsComponentDesc
{
	int _canary;
	EcsEntity entity;
	EcsTypeInfo type;
}

struct EcsQueryDesc
{
	int _canary;
	EcsTerm[32] terms;
	ZString expr;
	EcsQueryCacheKind cache_kind;
	EcsFlags32 flags;
	EcsOrderByAction order_by_callback;
	EcsSortTableAction order_by_table_callback;
	EcsEntity order_by;
	EcsId group_by;
	EcsGroupByAction group_by_callback;
	EcsGroupCreateAction on_group_create;
	EcsGroupDeleteAction on_group_delete;
	void* group_by_ctx;
	EcsCtxFree group_by_ctx_free;
	void* ctx;
	void* binding_ctx;
	EcsCtxFree ctx_free;
	EcsCtxFree binding_ctx_free;
	EcsEntity entity;
}

struct EcsObserverDesc
{
	int _canary;
	EcsEntity entity;
	EcsQueryDesc query;
	EcsEntity[8] events;
	bool yield_existing;
	bool global_observer;
	EcsIterAction callback;
	EcsRunAction run;
	void* ctx;
	EcsCtxFree ctx_free;
	void* callback_ctx;
	EcsCtxFree callback_ctx_free;
	void* run_ctx;
	EcsCtxFree run_ctx_free;
	int* last_event_id;
	ichar term_index_;
	EcsFlags32 flags_;
}

struct EcsEventDesc
{
	EcsEntity event;
	EcsType* ids;
	EcsTable* table;
	EcsTable* other_table;
	int offset;
	int count;
	EcsEntity entity;
	void* param;
	void* const_param;
	EcsPoly* observable;
	EcsFlags32 flags;
}

struct EcsSystemDesc
{
	int _canary;
	EcsEntity entity;
	EcsQueryDesc query;
	EcsEntity phase;
	EcsIterAction callback;
	EcsRunAction run;
	void* ctx;
	EcsCtxFree ctx_free;
	void* callback_ctx;
	EcsCtxFree callback_ctx_free;
	void* run_ctx;
	EcsCtxFree run_ctx_free;
	float interval;
	int rate;
	EcsEntity tick_source;
	bool multi_threaded;
	bool immediate;
}

struct EcsPipelineDesc
{
	EcsEntity entity;
	EcsQueryDesc query;
}

struct EcsBuildInfo
{
	ZString compiler;
	ZString* addons;
	ZString* flags;
	ZString version;
	short version_major;
	short version_minor;
	short version_patch;
	bool debug;
	bool sanitize;
	bool perf_trace;
}

struct EcsWorldInfoCmd
{
	long add_count;
	long remove_count;
	long delete_count;
	long clear_count;
	long set_count;
	long ensure_count;
	long modified_count;
	long discard_count;
	long event_count;
	long other_count;
	long batched_entity_count;
	long batched_command_count;
}

struct EcsWorldInfo
{
	EcsEntity last_component_id;
	float delta_time_raw;
	float delta_time;
	float time_scale;
	float target_fps;
	float frame_time_total;
	float system_time_total;
	float emit_time_total;
	float merge_time_total;
	float rematch_time_total;
	double world_time_total;
	double world_time_total_raw;
	long frame_count_total;
	long merge_count_total;
	long eval_comp_monitors_total;
	long rematch_count_total;
	long id_create_total;
	long id_delete_total;
	long table_create_total;
	long table_delete_total;
	long pipeline_build_count_total;
	long systems_ran_total;
	long observers_ran_total;
	long queries_ran_total;
	int tag_id_count;
	int component_id_count;
	int pair_id_count;
	int table_count;
	uint creation_time;
	EcsWorldInfoCmd cmd;
	ZString name_prefix;
}

struct EcsQueryGroupInfo
{
	ulong id;
	int match_count;
	int table_count;
	void* ctx;
}

struct EcsQueryCount
{
	int results;
	int entities;
	int tables;
}

struct EcsVec
{
	void* array;
	int count;
	int size;
}

struct EcsEntityRange
{
	uint min;
	uint max;
	uint cur;
	EcsVec recycled;
}

struct EcsRef
{
	EcsEntity entity;
	ulong table_id;
	uint table_version_fast;
	ushort table_version;
	void* ptr;
	EcsEntity id;
}

struct EcsTableRange
{
	EcsTable* table;
	int offset;
	int count;
}

struct EcsVar
{
	EcsTableRange range;
	EcsEntity entity;
}

struct EcsPageIter
{
	int offset;
	int limit;
	int remaining;
}

struct EcsWorkerIter
{
	int index;
	int count;
}

struct EcsTableCacheIter
{
	void* cur;
	void* next;
	bool iter_fill;
	bool iter_empty;
}

struct EcsEachIter
{
	EcsTableCacheIter it;
	EcsId ids;
	EcsEntity sources;
	EcsSize sizes;
	short columns;
	EcsTableRecord* trs;
}

struct EcsQueryOpProfile
{
	int[2] count;
}

struct EcsQueryIter
{
	EcsVar* vars;
	void* query_vars;
	void* ops;
	void* op_ctx;
	ulong* written;
	void* group;
	EcsVec* tables;
	EcsVec* all_tables;
	void* elem;
	int cur;
	int all_cur;
	EcsQueryOpProfile* profile;
	short op;
	bool iter_single_group;
}

union EcsIterUnion
{
	EcsQueryIter query;
	EcsPageIter page;
	EcsWorkerIter worker;
	EcsEachIter each;
}

struct EcsIterPrivate
{
	EcsIterUnion iter;
	void* entity_iter;
	EcsStackCursor* stack_cursor;
}

struct EcsIter
{
	EcsWorld* world;
	EcsWorld* real_world;
	int offset;
	int count;
	EcsEntity* entities;
	void** ptrs;
	EcsTableRecord** trs;
	short* columns;
	EcsSize* sizes;
	EcsTable* table;
	EcsTable* other_table;
	EcsId* ids;
	EcsEntity* sources;
	EcsFlags64 constrained_vars;
	EcsFlags32 set_fields;
	EcsFlags32 ref_fields;
	EcsFlags32 row_fields;
	EcsFlags32 up_fields;
	EcsEntity system;
	EcsEntity event;
	EcsId event_id;
	int event_cur;
	ichar field_count;
	ichar term_index;
	EcsQuery* query;
	void* param;
	void* ctx;
	void* binding_ctx;
	void* callback_ctx;
	void* run_ctx;
	float delta_time;
	float delta_system_time;
	int frame_offset;
	EcsFlags32 flags;
	EcsEntity interrupted_by;
	EcsIterPrivate priv_;
	EcsIterNextAction next;
	EcsIterAction callback;
	EcsIterFiniAction fini;
	EcsIter* chain_it;
}

struct EcsIdentifier
{
	ZString value;
	EcsSize length;
	ulong hash;
	ulong index_hash;
	EcsHashMap* index;
}

struct EcsComponent
{
	EcsSize size;
	EcsSize alignment;
}

struct EcsPolyC
{
	EcsPoly* poly;
}

struct EcsDefaultChildComponent
{
	EcsId component;
}

struct EcsParent
{
	EcsEntity value;
}

struct EcsTreeSpawnerChild
{
	ZString child_name;
	EcsTable* table;
	uint child;
	int parent_index;
}

struct EcsTreeSpawner
{
	EcsVec children;
}

// ---------------------------------------------------------------------------
// JSON addon
// ---------------------------------------------------------------------------

alias EcsJsonLookupAction = fn EcsEntity(EcsWorld* world, ZString value, void* ctx);
alias EcsJsonComponentFilter = fn bool(EcsWorld* world, EcsEntity component);

struct EcsFromJsonDesc
{
	ZString name;
	ZString expr;
	EcsJsonLookupAction lookup_action;
	void* lookup_ctx;
	bool strict;
}

struct EcsEntityToJsonDesc
{
	bool serialize_entity_id;
	bool serialize_doc;
	bool serialize_full_paths;
	bool serialize_inherited;
	bool serialize_values;
	bool serialize_builtin;
	bool serialize_type_info;
	bool serialize_alerts;
	EcsEntity serialize_refs;
	bool serialize_matches;
	EcsJsonComponentFilter component_filter;
}

struct EcsWorldToJsonDesc
{
	bool serialize_builtin;
	bool serialize_modules;
}

