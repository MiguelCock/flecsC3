// ---------------------------------------------------------------------------
// Script addon
// ---------------------------------------------------------------------------

alias EcsScript = void;
alias EcsScriptVars = void;
alias EcsScriptRuntime = void;

struct EcsScriptEvalDesc
{
	EcsScriptVars* vars;
	EcsScriptRuntime* runtime;
}

struct EcsScriptEvalResult
{
	ZString error;
	int line;
	int column;
}

struct EcsScriptDesc
{
	EcsEntity entity;
	ZString filename;
	ZString code;
}

// ---------------------------------------------------------------------------
// Metrics addon
// ---------------------------------------------------------------------------

struct EcsMetricDesc
{
	int _canary;
	EcsEntity entity;
	EcsEntity member;
	ZString dotmember;
	EcsId id;
	bool targets;
	EcsEntity kind;
	ZString brief;
}

// ---------------------------------------------------------------------------
// Alerts addon
// ---------------------------------------------------------------------------

struct EcsAlertSeverityFilter
{
	EcsEntity severity;
	EcsId with;
	ZString var_name;
	int _var_index;
}

struct EcsAlertDesc
{
	int _canary;
	EcsEntity entity;
	EcsQueryDesc query;
	ZString message;
	ZString doc_name;
	ZString brief;
	EcsEntity severity;
	EcsAlertSeverityFilter[4] severity_filters;
	float retain_period;
	EcsEntity member;
	EcsId id;
	ZString var_name;
}

// ---------------------------------------------------------------------------
// App addon
// ---------------------------------------------------------------------------

alias EcsAppInitAction = fn int(EcsWorld* world);
alias EcsAppRunAction = fn int(EcsWorld* world, EcsAppDesc* desc);
alias EcsAppFrameAction = fn int(EcsWorld* world, EcsAppDesc* desc);

struct EcsAppDesc
{
	float target_fps;
	float delta_time;
	int threads;
	int frames;
	bool enable_rest;
	bool enable_stats;
	ushort port;
	EcsAppInitAction init;
	void* ctx;
}

// ---------------------------------------------------------------------------
// Units addon
// ---------------------------------------------------------------------------

struct EcsUnitTranslation
{
	int factor;
	int power;
}

struct EcsUnitDesc
{
	EcsEntity entity;
	ZString symbol;
	EcsEntity quantity;
	EcsEntity base;
	EcsEntity over;
	EcsUnitTranslation translation;
	EcsEntity prefix;
}

struct EcsUnitPrefixDesc
{
	EcsEntity entity;
	ZString symbol;
	EcsUnitTranslation translation;
}

// ---------------------------------------------------------------------------
// HTTP / REST addons
// ---------------------------------------------------------------------------

alias EcsHttpServer = void;

struct EcsHttpServerDesc
{
	void* callback;
	void* ctx;
	ushort port;
	ZString ipaddr;
	int send_queue_wait_ms;
	double cache_timeout;
	double cache_purge_timeout;
}

// ---------------------------------------------------------------------------
// OS API addon
// ---------------------------------------------------------------------------

alias EcsOsThread = uptr;
alias EcsOsCond = uptr;
alias EcsOsMutex = uptr;
alias EcsOsDl = uptr;
alias EcsOsSock = uptr;
alias EcsOsThreadId = ulong;
alias EcsOsProc = fn void();

struct EcsTime
{
	uint sec;
	uint nanosec;
}

alias EcsOsThreadCallback = fn void*(void* param);
alias EcsOsApiInit = fn void();
alias EcsOsApiFini = fn void();
alias EcsOsApiMalloc = fn void*(int size);
alias EcsOsApiRealloc = fn void*(void* ptr, int size);
alias EcsOsApiCalloc = fn void*(int size);
alias EcsOsApiFree = fn void(void* ptr);
alias EcsOsApiStrdup = fn ZString(ZString str);
alias EcsOsApiThreadNew = fn EcsOsThread(EcsOsThreadCallback callback, void* param);
alias EcsOsApiThreadJoin = fn void*(EcsOsThread thread);
alias EcsOsApiThreadSelf = fn EcsOsThreadId();
alias EcsOsApiAinc = fn int(int* value);
alias EcsOsApiLainc = fn long(long* value);
alias EcsOsApiMutexNew = fn EcsOsMutex();
alias EcsOsApiMutexLock = fn void(EcsOsMutex mutex);
alias EcsOsApiMutexFree = fn void(EcsOsMutex mutex);
alias EcsOsApiCondNew = fn EcsOsCond();
alias EcsOsApiCondFree = fn void(EcsOsCond cond);
alias EcsOsApiCondSignal = fn void(EcsOsCond cond);
alias EcsOsApiCondBroadcast = fn void(EcsOsCond cond);
alias EcsOsApiCondWait = fn void(EcsOsCond cond, EcsOsMutex mutex);
alias EcsOsApiSleep = fn void(int sec, int nanosec);
alias EcsOsApiGetTime = fn void(EcsTime* time_out);
alias EcsOsApiNow = fn ulong();
alias EcsOsApiLog = fn void(int level, ZString file, int line, ZString msg);
alias EcsOsApiAbort = fn void();
alias EcsOsApiDlopen = fn EcsOsDl(ZString libname);
alias EcsOsApiDlproc = fn EcsOsProc(EcsOsDl lib, ZString procname);
alias EcsOsApiDlclose = fn void(EcsOsDl lib);
alias EcsOsApiModuleToPath = fn ZString(ZString module_id);
alias EcsOsApiFopen = fn void*(ZString file, ZString mode);
alias EcsOsApiFclose = fn void(void* file);
alias EcsOsApiPerfTrace = fn void(ZString filename, usz line, ZString name);

struct EcsOsApi
{
	EcsOsApiInit init_;
	EcsOsApiFini fini_;
	EcsOsApiMalloc malloc_;
	EcsOsApiRealloc realloc_;
	EcsOsApiCalloc calloc_;
	EcsOsApiFree free_;
	EcsOsApiStrdup strdup_;
	EcsOsApiThreadNew thread_new_;
	EcsOsApiThreadJoin thread_join_;
	EcsOsApiThreadSelf thread_self_;
	EcsOsApiThreadNew task_new_;
	EcsOsApiThreadJoin task_join_;
	EcsOsApiAinc ainc_;
	EcsOsApiAinc adec_;
	EcsOsApiLainc lainc_;
	EcsOsApiLainc ladec_;
	EcsOsApiMutexNew mutex_new_;
	EcsOsApiMutexFree mutex_free_;
	EcsOsApiMutexLock mutex_lock_;
	EcsOsApiMutexLock mutex_unlock_;
	EcsOsApiCondNew cond_new_;
	EcsOsApiCondFree cond_free_;
	EcsOsApiCondSignal cond_signal_;
	EcsOsApiCondBroadcast cond_broadcast_;
	EcsOsApiCondWait cond_wait_;
	EcsOsApiSleep sleep_;
	EcsOsApiNow now_;
	EcsOsApiGetTime get_time_;
	EcsOsApiLog log_;
	EcsOsApiAbort abort_;
	EcsOsApiDlopen dlopen_;
	EcsOsApiDlproc dlproc_;
	EcsOsApiDlclose dlclose_;
	EcsOsApiModuleToPath module_to_dl_;
	EcsOsApiModuleToPath module_to_etc_;
	EcsOsApiFopen fopen_;
	EcsOsApiFclose fclose_;
	EcsOsApiPerfTrace perf_trace_push_;
	EcsOsApiPerfTrace perf_trace_pop_;
	int log_level_;
	int log_indent_;
	int log_last_error_;
	long log_last_timestamp_;
	EcsFlags32 flags_;
	void* log_out_;
}

// ---------------------------------------------------------------------------
// Stats addon
// ---------------------------------------------------------------------------

struct EcsGauge
{
	float[60] avg;
	float[60] min;
	float[60] max;
}

struct EcsCounter
{
	EcsGauge rate;
	double[60] value;
}

union EcsMetric
{
	EcsGauge gauge;
	EcsCounter counter;
}

struct EcsWorldStatsEntities
{
	EcsMetric count;
	EcsMetric not_alive_count;
}

struct EcsWorldStatsComponents
{
	EcsMetric tag_count;
	EcsMetric component_count;
	EcsMetric pair_count;
	EcsMetric type_count;
	EcsMetric create_count;
	EcsMetric delete_count;
}

struct EcsWorldStatsTables
{
	EcsMetric count;
	EcsMetric empty_count;
	EcsMetric create_count;
	EcsMetric delete_count;
}

struct EcsWorldStatsQueries
{
	EcsMetric query_count;
	EcsMetric observer_count;
	EcsMetric system_count;
}

struct EcsWorldStatsCommands
{
	EcsMetric add_count;
	EcsMetric remove_count;
	EcsMetric delete_count;
	EcsMetric clear_count;
	EcsMetric set_count;
	EcsMetric ensure_count;
	EcsMetric modified_count;
	EcsMetric other_count;
	EcsMetric discard_count;
	EcsMetric batched_entity_count;
	EcsMetric batched_count;
}

struct EcsWorldStatsFrame
{
	EcsMetric frame_count;
	EcsMetric merge_count;
	EcsMetric rematch_count;
	EcsMetric pipeline_build_count;
	EcsMetric systems_ran;
	EcsMetric observers_ran;
	EcsMetric event_emit_count;
}

struct EcsWorldStatsPerformance
{
	EcsMetric world_time_raw;
	EcsMetric world_time;
	EcsMetric frame_time;
	EcsMetric system_time;
	EcsMetric emit_time;
	EcsMetric merge_time;
	EcsMetric rematch_time;
	EcsMetric fps;
	EcsMetric delta_time;
}

struct EcsWorldStatsMemory
{
	EcsMetric alloc_count;
	EcsMetric realloc_count;
	EcsMetric free_count;
	EcsMetric outstanding_alloc_count;
	EcsMetric block_alloc_count;
	EcsMetric block_free_count;
	EcsMetric block_outstanding_alloc_count;
	EcsMetric stack_alloc_count;
	EcsMetric stack_free_count;
	EcsMetric stack_outstanding_alloc_count;
}

struct EcsWorldStatsHttp
{
	EcsMetric request_received_count;
	EcsMetric request_invalid_count;
	EcsMetric request_handled_ok_count;
	EcsMetric request_handled_error_count;
	EcsMetric request_not_handled_count;
	EcsMetric request_preflight_count;
	EcsMetric send_ok_count;
	EcsMetric send_error_count;
	EcsMetric busy_count;
}

struct EcsWorldStats
{
	long first_;
	EcsWorldStatsEntities entities;
	EcsWorldStatsComponents components;
	EcsWorldStatsTables tables;
	EcsWorldStatsQueries queries;
	EcsWorldStatsCommands commands;
	EcsWorldStatsFrame frame;
	EcsWorldStatsPerformance performance;
	EcsWorldStatsMemory memory;
	EcsWorldStatsHttp http;
	long last_;
	int t;
}

struct EcsQueryStats
{
	long first_;
	EcsMetric result_count;
	EcsMetric matched_table_count;
	EcsMetric matched_entity_count;
	long last_;
	int t;
}

struct EcsSystemStats
{
	long first_;
	EcsMetric time_spent;
	long last_;
	bool task;
	EcsQueryStats query;
}

struct EcsSyncStats
{
	long first_;
	EcsMetric time_spent;
	EcsMetric commands_enqueued;
	long last_;
	int system_count;
	bool multi_threaded;
	bool immediate;
}

struct EcsPipelineStats
{
	ichar canary_;
	EcsVec systems;
	EcsVec sync_points;
	int t;
	int system_count;
	int active_system_count;
	int rebuild_count;
}
