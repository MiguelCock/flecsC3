struct EcsMemberValueRange
{
	double min;
	double max;
}

struct EcsMember
{
	ZString name;
	EcsEntity type;
	int count;
	int offset;
	EcsEntity unit;
	bool use_offset;
	EcsMemberValueRange range;
	EcsMemberValueRange error_range;
	EcsMemberValueRange warning_range;
	EcsSize size;
	EcsEntity member;
}

struct EcsMemberC
{
	EcsEntity type;
	int count;
	EcsEntity unit;
	int offset;
	bool use_offset;
}

struct EcsStruct
{
	EcsVec members;
}

struct EcsPrimitive
{
	EcsPrimitiveKind kind;
}

struct EcsEnum
{
	EcsEntity underlying_type;
}

struct EcsBitmask
{
	int dummy_;
}

struct EcsArray
{
	EcsEntity type;
	int count;
}

struct EcsVector
{
	EcsEntity type;
}

struct EcsEnumConstant
{
	ZString name;
	long value;
	ulong value_unsigned;
	EcsEntity constant;
}

struct EcsBitmaskConstant
{
	ZString name;
	ulong value;
	long _unused;
	EcsEntity constant;
}

struct EcsPrimitiveDesc
{
	EcsEntity entity;
	EcsPrimitiveKind kind;
}

struct EcsEnumDesc
{
	EcsEntity entity;
	EcsEnumConstant[32] constants;
	EcsEntity underlying_type;
}

struct EcsBitmaskDesc
{
	EcsEntity entity;
	EcsBitmaskConstant[32] constants;
}

struct EcsArrayDesc
{
	EcsEntity entity;
	EcsEntity type;
	int count;
}

struct EcsVectorDesc
{
	EcsEntity entity;
	EcsEntity type;
}

struct EcsStructDesc
{
	EcsEntity entity;
	EcsMember[32] members;
	bool create_member_entities;
}

